{
  "name": "gemgo",
  "version": "0.1.0",
  "description": "Mobile-first PWA for crowd-aware Alpine trip planning, GemDrop, GemPoints and GemDeals.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mattiacentonze/gemgo.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:vercel": "node scripts/generate-build-info.mjs && node scripts/check-i18n.mjs && next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vercel": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:authenticated": "NEXT_PUBLIC_GEMGO_E2E_MOCK_AUTH=1 npm run build:vercel && NEXT_PUBLIC_GEMGO_E2E_MOCK_AUTH=1 playwright test tests/authenticated-contribution-flow.spec.ts",
    "test:visual": "npm run build:vercel && playwright test tests/visual-user-stories.spec.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "npm run i18n:check && bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/leaflet": "^1.9.21",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "GemGo MVP"
}
